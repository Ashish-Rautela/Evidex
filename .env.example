# Database
DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789:secret:evidex/db-credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evidex
DB_USER=postgres
DB_PASSWORD=postgres

# AWS
AWS_REGION=ap-south-1
S3_BUCKET=evidex-contracts-dev
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789/evidex-ingestion-queue
SNS_TEXTRACT_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789:evidex-textract-complete
TEXTRACT_ROLE_ARN=arn:aws:iam::123456789:role/evidex-textract-role

# Cognito
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Bedrock
# Best for legal text accuracy (recommended):
BEDROCK_EMBED_MODEL_ID=cohere.embed-english-v3
# Fallback (lower accuracy, no batching):
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_RERANK_MODEL_ARN=arn:aws:bedrock:ap-south-1::foundation-model/cohere.rerank-v3-5:0
